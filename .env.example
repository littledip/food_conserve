# Anthropic API key used for receipt vision parsing, and for pantry chat
# when PANTRY_CHAT_BACKEND is unset or "anthropic".
# Get one at https://console.anthropic.com/ then copy this file to `.env`
# (which is gitignored) and fill in the value below.
ANTHROPIC_API_KEY=

# Pantry chat backend prototype toggle: "anthropic" (default) or "ollama".
PANTRY_CHAT_BACKEND=anthropic

# Only needed when PANTRY_CHAT_BACKEND=ollama. Must be reachable from your
# phone, not just your dev machine — localhost means the phone itself, so use
# a LAN hostname (e.g. http://your-mac.local:11434) or your machine's IP.
# The model must be tagged with "tools" capability (`ollama show <model>`).
OLLAMA_BASE_URL=http://your-mac.local:11434
OLLAMA_MODEL=llama3.1:8b
